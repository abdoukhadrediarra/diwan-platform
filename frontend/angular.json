{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "2fbeb03f-2697-43b7-ab26-1ae0eae496c3"
  },
  "newProjectRoot": "projects",
  "projects": {
    "diwan-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/amiri/400.css",
              "node_modules/@fontsource/amiri/700.css",
              "node_modules/@fontsource/source-sans-3/400.css",
              "node_modules/@fontsource/source-sans-3/600.css",
              "node_modules/@fontsource/source-sans-3/700.css",
              "src/styles.scss"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "allowedCommonJsDependencies": [
              "html2pdf.js",
              "html2canvas",
              "jspdf",
              "canvg",
              "dompurify",
              "fflate"
            ],
            "ssr": {
              "entry": "src/server.ts"
            },
            "stylePreprocessorOptions": {
              "sass": {
                "silenceDeprecations": [
                  "import",
                  "global-builtin",
                  "color-functions",
                  "if-function"
                ]
              }
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all",
              "define": {
                "NG_API_BASE_URL": "\"https://diwan-platform.onrender.com/api/v1\""
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "define": {
                "NG_API_BASE_URL": "\"\""
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "diwan-web:build:production"
            },
            "development": {
              "buildTarget": "diwan-web:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
