    },
    {
      "position": 16,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 14,
      "hemistichs": [
        "شَقَاوَةٌ وَضَرَرٌ وَوَلَمُ",
        "إِلَى سِوَايَ يَنْتَحِي وَأَلَمُ"
