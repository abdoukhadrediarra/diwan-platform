    },
    {
      "position": 17,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 15,
      "hemistichs": [
        "يَسُوقُ مَنْ لَيْسَ لَهُ مُنَازِعُ",
        "لِغَيْرِيَ الْعِدَى فَلَا أُنَازِعُ"
