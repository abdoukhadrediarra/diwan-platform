    },
    {
      "position": 19,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 17,
      "hemistichs": [
        "أَلَمُ مَنْ حَسَدَنِي لَا يَنْصَرِمْ",
        "وَبِشْرُ مَنْ يُحِبُّنِي لَا يَنْخَرِمْ"
      ]
    },
    {
      "position": 20,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 18,
      "hemistichs": [
        "نَحَتْ لِغَيْرِ ضَرَرِي أَقْدَارُ مَنْ",
        "لَهُ الْبَرَايَا وَالْفِعَالُ وَالزَّمَنْ"
