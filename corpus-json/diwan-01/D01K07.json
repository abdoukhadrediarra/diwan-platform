    },
    {
      "position": 18,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 16,
      "hemistichs": [
        "طَافَ اللَّعِينُ لِسِوَايَ سَرْمَدَا",
        "طَرَدَهُ الْبَاقِي لِغَيْرِي مُكْمَدَا"
