      "hemistichs": [
        "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ اللَّهُمَّ صَلِّ وَسَلِّمْ وَبَارِكْ عَلَى سَيِّدِنَا وَمَوْلَانَا مُحَمَّدٍ وَآلِهِ وَصَحْبِهِ صَلَاةً وَسَلَامًا وَبَرَكَةً تَتَقَبَّلُ بِهَا بِقَدْرِ عَظَمَةِ ذَاتِكَ تَعَوُّذَ هَذَا الْعَبْدِ الْخَدِيمِ بِكَ بِقَوْلِهِ مِنْهُ وَتَرْضَى بِهَا أَبَدًا عَنْهُ"
      ]
    },
    {
      "position": 2,
      "section": "title",
      "kind": "title",
      "bayt_number": null,
      "hemistichs": [
        "أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ"
      ]
    },
    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "أَعَاذَنِي اللَّهُ مِنَ الشَّيْطَانِ",
        "فِي كُلِّ مَجْلِسٍ وَفِي أَوْطَانِ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "عَلَّمَنِي الْعَلِيمُ تَعْلِيمَ الْعَلِيمْ",
        "وَقَادَ لِي فِي خِدْمَةِ النَّبِيِّ الْعُلُومْ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "وَجَّهَ مَنْ كَفَّ النَّبِيَّ حُسَّدَهْ",
        "بِهِ إِلَى سِوَايَ كُلَّ مَفْسَدَهْ"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "ذَبَّ بِلَا تَسْلِيطٍ الْبَاقِي الْقَدِيمْ",
        "أَعْدَاءَهُ إِلَى سِوَى الْعَبْدِ الْخَدِيمْ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "بِسْمِ الْإِلَهِ حَبَّذَا الرَّحْمَانُ",
        "نِعْمَ الرَّحِيمُ مَنْ لَهُ الْأَزْمَانُ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "الْحَمْدُ لِلْإِلَهِ رَبِّ الْعَالَمِينْ",
        "عَلَى الْأَمِينِ وَالْأَمِينِ وَالْأَمِينْ"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "لَكَ شُكُورِي بَعْدَ حَمْدٍ سَرْمَدَا",
        "وَإِنَّهُ كُلِّيَّتِي قَدْ حَمِدَا"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "لَهُ صَرَفْتُ كُلَّ حَمْدٍ أَبَدَا",
        "وَلَا يُوَجِّهُ إِلَيَّ كَبَدَا"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "هدَانِيَ الْهَادِي فَلَا أَضِلُّ",
        "وَعَنْ سَبِيلِ اللَّهِ لَا أُضَلُّ"
      ]
    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "مَنَّ عَلَيَّ اللَّهُ بِاسْتِقَامَهْ",
        "وَجَادَ بِالْكِتَابِ وَالْإِقَامَهْ"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "نَبِيُّنَا عَنِّي مَحَا الْمَلَامَهْ",
        "ذَا عِصْمَةٍ وَفُزْتُ بِالسَّلَامَهْ"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "إِلَى سِوَايَ الضُّرُّ كَالْأَعْدَاءِ",
        "وَلَا أُلَاقِي مُوجِبَاتِ دَآءِ"
      ]
    },
    {
      "position": 15,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 13,
      "hemistichs": [
        "لِغَيْرِيَ الْفَسَادُ وَالشَّيْطَانُ",
        "يَطِيبُ لِيَ الْمَجْلِسُ وَالْأَوْطَانُ"
