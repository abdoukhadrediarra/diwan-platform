    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "إِلَيَّ قَادَ خَيْرَ عِلْمٍ نَافِعِ",
        "وَمَا لِيَ اخْتَارَ مِنَ الْمَنَافِعِ"
