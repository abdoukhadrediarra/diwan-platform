      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "بَرَّأَنِي مَنْ كَانَ لِي بِنِيَّتِي",
        "مِنْ كَذِبٍ وَمِنْ لَغًى وَفِرْيَةِ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "شَهِدَ لِي رَبِّي بِكَوْنِي عَبْدَهْ",
        "وَخِلَّهُ وَحِبَّهُ وَعِنْدَهْ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "رَافَقْتُ جُنْدَ اللَّهِ فِي تَغَرُّبِي",
        "وَلَمْ أَزَلْ لِلَّهِ ذَا تَقَرُّبِ"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "فَازَتْ قِلَامِي وَمِدَادِي وَالْجَسَدْ",
        "فَوْزًا بِهِ وَلَّى لِغَيْرِي مَنْ حَسَدْ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "أَرْضَيْتُ رَبِّيَ وَأَدْخَلْتُ السُّرُورْ",
        "عَلَى فُؤَادِ مَنْ كَفَانِيَ الْغَرُورْ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "سَلَبَ لِي نُورَ لِسَانِ الْعَرَبِ",
        "أَزْمَانَ إِخْدَامِي النَّبِيُّ الْعَرَبِي"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "تَمَّمَ لِي الشَّكُورُ مَا نَوَيْتُ",
        "وَفَوْقَ مَا قَصَدْتُهُ حَوَيْتُ"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "بَارَكَ لِي الْبَدِيعُ فِي لُزُومِي",
        "وَفِي جِنَاسِيَ بِذِي الْحَيْزُومِ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "شَهِدَ لِي اللَّهُ وَجُنْدُ اللَّهِ",
        "بِأَنَّنِي ذَبَبْتُ كُلَّ لَاهِ"
      ]
    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "رَضِيتُ عَنْ رَبِّي وَرَبِّي رَضِيَا",
        "عَنِّي وَبِالْمَاحِي مَحَا مَرَضِيَا"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "وَاجَهَنِي ذُو الأَرَضِينَ وَالطِّبَاقْ",
        "بِمَا كَفَانِيَ اللَّعِينَ ذَا إِبَاقْ"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "أَكْرَمَنِي مَنْ صَانَنِي عَنْ فِرْيَةِ",
        "وَعَنْ لَغًى وَكَانَ لِي بِنِيَّتِي"
      ]
    },
    {
      "position": 15,
      "section": "khatima",
      "kind": "prose",
      "bayt_number": null,
      "hemistichs": [
        "بِبَيْعِكُمُ الَّذِي بَايَعْتُمْ بِهِ فِيمَا مَضَى قَبْلَ يَوْمِ خَطِّي هَذَا الْخَطَّ الَّذِي نُقِلَ مِنَ اللَّوْحِ الْمَحْفُوظِ وَاللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ وَسَلَامٌ عَلَى الْمُرْسَلِينَ وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"
      ]
    }
