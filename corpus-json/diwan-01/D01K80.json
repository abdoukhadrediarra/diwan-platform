      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "تَوْفِيقُ رَبِّيَ الَّذِي وَصَلْتُ",
        "لَهُ هَدَانِيَ وَمَا انْفَصَلْتُ"
