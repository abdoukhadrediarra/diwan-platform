        "وَالْقَوْلِ وَالْفِعْلِ وَنِعْمَ قَائِدِي"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "هَدِيَّةُ الْبَاقِي الْوَلِيِّ زَحْزَحَتْ",
        "لِغَيْرِيَ الْعِدَى وَرِبْحًا مَنَحَتْ"
