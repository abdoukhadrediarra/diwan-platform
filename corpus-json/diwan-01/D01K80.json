      "bayt_number": 1,
      "hemistichs": [
        "إِلَى إِلَهِي اللَّهِ قَدْ أَوْصَلْتُ",
        "الْحَمْدَ وَالشُّكْرَ لَدُنْ وَصَلْتُ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "صَمَدُنَا لَيْسَ لَهُ كُفْؤًا أَحَدْ",
        "وَأَحْمَدُ الْمُخْتَارُ لَيْثُ مَنْ جَحَدْ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "حَمِدْتُ رَبِّيَ عَلَى مُحَمَّدِ",
        "مُذْ قَادَنِي مُحَمَّدٌ لِلصَّمَدِ"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "أَحْمَدُنَا الْمُخْتَارُ نُورُ الرُّسُلِ",
        "عَلَى الْجَمِيعِ صَلَوَاتُ الْمُرْسِلِ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "بِاللَّهِ وَالرَّسُولِ وَالْكِتَابِ",
        "وَصَلْتُ لِلَّهِ بِلَا عِتَابِ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "أَوْرَثَنِي الذِّكْرَ الْحَكِيمَ الصَّمَدُ",
        "وَقَادَهُ إِلَى يَدِي مُحَمَّدُ"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
