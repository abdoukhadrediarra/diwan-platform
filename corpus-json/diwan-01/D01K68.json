      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "دِينِي كِتَابُ مَنْ مَحَا الْكَبَائِرَا",
        "وَحَائِرًا ذَبَّ لِغَيْرِي بَائِرَا"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "إِلَيَّ قَادَ مَنْ مَحَا الصَّغَائِرَا",
        "فَضْلَيْنِ مِنْهُ ظَاهِرًا وَغَائِرَا"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "هَدَانِيَ الَّذِي اشْتَرَى الضَّمَائِرَا",
        "وَلَا يَزَالُ مُغْنِيًا وَمَائِرَا"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "مَدَّ الَّذِي قَدْ أَنْزَلَ الدَّفَاتِرَا",
