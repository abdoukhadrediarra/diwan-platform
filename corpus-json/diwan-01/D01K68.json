      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "بَيَّنَ لِي مَنْ لَا يَزَالُ فَاطِرَا",
        "تَبْيِينَ هَادٍ نَوَّرَ الْخَوَاطِرَا"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "سَأَلْتُهُ وَقَادَ لِي مَشَاكِرَا",
