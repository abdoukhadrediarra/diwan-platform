    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "لَا يَنْتَحِي عَوْضُ وَقَطُّ مَا انْتَحَى",
        "مَا لَا يَلِيقُ لِجَمِيلٍ فَتَحَا"
