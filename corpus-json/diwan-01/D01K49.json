    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "هَرَبَ كُفْرٌ مَعْ شِرْكٍ وَفُسُوقْ",
        "لِغَيْرِ دِينِي وَحَوَيْتُ رِبْحَ سُوقْ"
      ]
    },
    {
      "position": 15,
      "section": "khatima",
      "kind": "prose",
      "bayt_number": null,
      "hemistichs": [
        "وَفَضْلٍ بِلَا شَيْءٍ مِنَ السُّوءِ أَبَدًا آمِينْ يَا رَبَّ الْعَالَمِينَ وَاجْعَلْ هَاتَيْنِ الْقَصِيدَتَيْنِ مِمَّا تَتَغَنَّى بِهِمَا الْحُورُ الْعِينُ وَمِمَّا يَسْتَعِيذُ مِنْهُمَا بِالْفِرَارِ كُلُّ شَيْطَانٍ وَكُلُّ كَافِرٍ وَكُلُّ فَاسِقٍ وَكُلُّ مُنَافِقٍ وَكُلُّ مَلْعُونٍ سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ وَسَلَامٌ عَلَى الْمُرْسَلِينَ وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"
      ]
    }
