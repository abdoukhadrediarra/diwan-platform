  "lines": [
    {
      "position": 1,
      "section": "muqaddima",
      "kind": "prose",
      "bayt_number": null,
      "hemistichs": [
        "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ"
      ]
    },
    {
      "position": 2,
      "section": "title",
      "kind": "title",
      "bayt_number": null,
      "hemistichs": [
        "وَمَا تَوْفِيقِيَ إِلَّا بِاللَّهِ"
      ]
    },
    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "وَجَّهْتُ وَجْهِي مُسْلِمًا لِلَّهِ",
        "وَصَانَنِي عَنْ خَطَإٍ وَلَاهِ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "مَدُّ يَدِي لِغَيْرِهِ لَيْسَ يَكُونْ",
        "وَإِنَّهُ قَدْ قَادَ لِي كُنْ فَيَكُونْ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "أَوْدَعَنِي كِتَابُهُ إِلَى الْجِنَانْ",
        "وَمَا لِيَ اخْتَارَ وَطَيَّبَ الْجَنَانْ"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "تَوْفِيقُهُ رَافَقَنِي فِي بَاطِنِي",
        "وَظَاهِرِي وَصَانَ لِي مَوَاطِنِي"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "وَلَّى لِغَيْرِي كَدَرٌ وَمَرَضُ",
        "وَلِي انْتَحَى إِلَى الْجِنَانِ الْغَرَضُ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "فَجَأَنِي بِبُشَرٍ تَدُومُ",
        "نِعْمَ الْكَرِيمُ ذُو الْبَقَآ الْقَدِيمُ"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "يَنْقَادُ لِي مِنْ مَالِكِي تَكَرُّمُ",
        "وَمِنْ نَبِيِّهِ أَتَانِي الْكَرَمُ"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "قَادَ لِيَ اللَّهُ جَزَاءَ اللَّهِ",
        "بِلَا أَذًى وَأَجْرَ عَبْدِ اللَّهِ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "يَقُودُ لِي بُشَارَةً قَدَرُ مَنْ",
        "لَهُ الْبَرَايَا وَالْفِعَالُ وَالزَّمَنْ"
      ]
    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "أَذْهَبَ عَنِّيَ الْمُكَرِّمُ الْحَزَنْ",
        "وَقَادَ لِي أَضْعَافَ مَا مِنِّي اتَّزَنْ"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "لِي قَادَ فَوْقَ مَا كَسَبْتُ أَجْرَا",
        "وَلَا يُوَجِّهُ لِنَحْوِي زَجْرَا"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "لَمْ يَنْحُنِي مَكْرٌ وَلَا غُرُورُ",
        "وَانْقَادَ لِي فِي عَادَتِي بُرُورُ"
      ]
    },
    {
      "position": 15,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 13,
      "hemistichs": [
        "أَقَامَنِي فِيمَا يَكُونُ رَاضِيَا",
        "عَنِّي بِهِ مَنْ قَادَ لِي أَغْرَاضِيَا"
      ]
    },
    {
      "position": 16,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 14,
      "hemistichs": [
        "بِعْتُ اخْتِيَارِي بِاخْتِيَارِ اللَّهِ",
        "وَصَانَنِي عَنْ جُمْلَةِ الْمَلَاهِي"
      ]
    },
    {
      "position": 17,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 15,
      "hemistichs": [
        "أَعْطَيْتُهُ كُلِّيَّتِي بِلَا نِزَاعْ",
        "وَصَانَنِي عَمَّا نَحَا ذَوُو النِّزَاعْ"
      ]
    },
    {
      "position": 18,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 16,
      "hemistichs": [
        "لِوَجْهِهِ الْكَرِيمِ قَدْ أَخَذْتُ",
        "مَا اخْتَارَ لِي وَعَكْسَهُ نَبَذْتُ"
      ]
    },
    {
      "position": 19,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 17,
      "hemistichs": [
        "لَهُ خِطَابِي وَلِغَيْرِي وَجَّهَا",
        "غَيْرَ رِضَاهُ وَالرِّضَى لِي اتَّجَهَا"
      ]
    },
    {
      "position": 20,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 18,
      "hemistichs": [
        "أَذْهَبْتَ كُلَّ مَا يَسُوءُ أَوْ يَضُرّ",
        "لِغَيْرِ نَحْوِي لَيْسَ يَنْحُونِيَ ضُرّ"
      ]
    },
    {
      "position": 21,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 19,
      "hemistichs": [
        "هَدِيَّتِي مُوصِلَةٌ لِلَّهِ",
        "عَاصِمَةٌ مِنْ ضَرَرٍ وَلَاهِ"
      ]
    }
  ]
}
