    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "دَعَا مِدَادِي لِامْتِدَاحِ أَحْمَدَا",
        "كَوْنِي خَدِيمَهُ وَأَفْنَى الْكَمَدَا"
