      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "قُلْتُ وَقَصْدِي شُكْرُ رَبِّي أَبَدَا",
        "بِلَا شِكَايَةٍ وَأَفْنَى الْكَبَدَا"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "الْحَمْدُ لِلَّهِ الَّذِي لَمْ يَلِدَا",
        "وَلَيْسَ مَوْلُودًا وَأَعْطَى الْبَلَدَا"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "لِلَّهِ شُكْرِي بَعْدَ حَمْدٍ خَلَدَا",
        "عَلَى الَّذِي خَيْرَ نَبِيٍّ وُلِدَا"
