        "يُؤْتِيهِمْ أُجُورَهُمْ"
      ]
    },
    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "يَنْقَادُ لِي الأَجْرُ بِلَا حِسَابِ",
        "مِمَّنْ لَهُ عُمْرِيَ ذَا احْتِسَابِ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "وَاجَهَنِي جَزَاءُ مُغْنٍ عَنْ كِيَلْ",
        "وَعَنْ تَسَبُّبٍ وَعَنْ كُلِّ حِيَلْ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "تَنْمُو أُجُورِي وَجَزَائِي أَبَدَا",
        "بِفَضْلِ مَنْ عِنْدَ عِدَاهُ عُبِدَا"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "يَقُودُ لِي مُخْجِلَ كُلِّ مُزْبِدِ",
        "مَنْ صَانَنِي عَنْ مُشْرِكٍ وَزَبَدِ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "هَرَبَ إِبْلِيسُ لِغَيْرِي بَعْدَ مَا",
        "بَاءَ بِخَيْبَةٍ أَدَامَتْ نَدَمَا"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "مَلَّكْتُ خَيْرَ الْخَلْقِ مَا نَفَى اللَّعِينْ",
        "عِنْدَ الْبُحُورِ لِسِوَايَ بِالْمُعِينْ"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "أَجْرِيَ فِي رَدِّ الَّذِينَ ثَلَّثُوا",
        "عَلَى الَّذِي بِهِ انْتَفَى الْمُثَلِّثُ"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "جَزَاءُ مَنْ مَا عِنْدَهُ لَا يَنْفَدُ",
        "لِي قَادَ مُخْجِلَ الَّذِينَ صَفَدُوا"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "وَلَّى لِغَيْرِي كُلُّ مَنْ لَا يَعْبُدُ",
        "وَقَادَ لِي اللَّهُ رِضَى مَنْ عَبَدُوا"
      ]
    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "رَافَقَنِي فِي اللَّهِ أَهْلُ بَدْرِ",
        "فَلِسِوَايَ مَالَ أَهْلُ الْغَدْرِ"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "هَذَّبْتُ لِلَّهِ عِبَادَةً لَدَى",
        "مَنْ جَحَدُوا وَلِيَ صَفَّى الْخَلَدَا"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "مَلَّكَنِي الأَجْرَ بِلَا حِسَابِ",
        "جَاعِلُ كُلِّي الدَّهْرَ فِي احْتِسَابِ"
      ]
    }
  ]
