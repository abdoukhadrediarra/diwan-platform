      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "أَوْصَلَ لِيَ الْبَاقِي بِلَا ارْتِيَابِ",
        "ثَمَنَ مَا قَدْ بِعْتُ بِالْغُيَابِ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "نَزَعَ لِي مَا اخْتَارَ لِي فِي الدُّنْيَا",
        "مِنَ الْمُنَى وَكَانَ لِي بِالثُّنْيَا"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "نَفَعَنِي النَّافِعُ فِي أُخْرَايَا",
        "وَقَادَ لِي بِلَا انْتِهَا بُشْرَايَا"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "أَخَذْتُ ذِكْرَهُ الْحَكِيمَ عَنْهُ",
        "مُلَازِمًا وَمُسْتَفِيدًا مِنْهُ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "لَمْ يَنْحُنِي زَجْرٌ وَلَا وَعِيدُ",
        "وَعُمْرِيَ إِلَى الْجِنَانِ عِيدُ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "لَمْ يَنْحُنِي مَكْرٌ وَلَا اسْتِدْرَاجُ",
        "وَلَا غُرُورٌ وَلِيَ الْخَرَاجُ"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "أَلَانَ لِي عِدَى إِلَهِي الأَعْظَمُ",
        "وَلَيْسَ يَنْحُو جِهَتِي تَعَظُّمُ"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "هَدَمْتُ مَا بَنَاهُ لِي إِبْلِيسُ",
        "وَلِسِوَى مَالِي انْتَحَى تَفْلِيسُ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "أَبْقَانِيَ الْبَاقِي بِلَا اغْتِرَارِ",
        "وَانْقَادَ لِيَ التَّبْشِيرُ بِانْجِرَارِ"
