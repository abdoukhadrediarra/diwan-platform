    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "شَكَرْتُ ذَا الْعَرْشِ الْعَظِيمِ شُكْرَا",
        "بِهِ انْجِعَالُ مَا كَتَبْتُ ذِكْرَا"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "تَوْفِيقُ مُلْهِمٍ يُعَلِّمُ الْغُيُوبْ",
        "طَهَّرَنِي مِنَ اللَّغَى وَمِنْ عُيُوبْ"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "رَافَقَ عَقْدِي وَمَقَالِي وَالْفِعَالْ",
        "وَخُلُقِي كُنْ فَيَكُونُ بِانْفِعَالْ"
      ]
    },
    {
      "position": 15,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 13,
      "hemistichs": [
        "أَنَالَنِي الْعِصْمَةَ كَالْغُيَابِ",
        "مَنْ سِلَعِي اشْتَرَى بِلَا ارْتِيَابِ"
      ]
    },
    {
      "position": 16,
      "section": "khatima",
      "kind": "prose",
      "bayt_number": null,
      "hemistichs": [
        "مِنَ الْمُؤْمِنِينَ ذَاهِبًا إِلَى غَيْرِ ذَاتِي كُلَّ مَا بَاعَهُ عَنِّي بِلَا تَوْجِيهِ شَيْءٍ مِنْهُ إِلَيَّ أَبَدًا وَبِلَا آفَةٍ وَلَا كَدَرٍ فِيَّ وَلَا بَيْنِي وَبَيْنَ أَحَدٍ أَبَدًا آمِينَ يَا رَبَّ الْعَالَمِينَ"
      ]
