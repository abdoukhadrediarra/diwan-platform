    {
      "position": 16,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 14,
      "hemistichs": [
        "الْحَمْدُ لِلَّهِ عَلَى إِبْدَالِ",
        "مَا بِعْتُ وَاشْتَرَى بِلَا جِدَالِ"
      ]
    },
    {
      "position": 17,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 15,
      "hemistichs": [
        "نَفَى مَبِيعَاتِي الَّذِي اشْتَرَى بِلَا",
