    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "أَشْكُرُهُ مِنْ بَعْدِ حَمْدٍ وَرِضَى",
        "بِلَا نِهَايَةٍ وَقَادَ لِي الرِّضَى"
