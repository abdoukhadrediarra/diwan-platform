    },
    {
      "position": 18,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 16,
      "hemistichs": [
        "يَقُولُ كُلِّي الْحَمْدُ لِلَّهِ مَعَا",
        "صَلَاتِهِ عَلَى بَشِيرٍ جَمَعَا"
