      "hemistichs": [
        "أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ وَإِنِّيَ أُعِيذُهَا بِكَ وَذُرِّيَّتَهَا مِنَ الشَّيْطَانِ الرَّجِيمِ رَبِّ أَعُوذُ بِكَ مِنْ هَمَزَاتِ الشَّيَاطِينِ وَأَعُوذُ بِكَ رَبِّ أَنْ يَحْضُرُونِ بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ اللَّهُمَّ يَا مَنْ قَالَ وَقَوْلُكَ الْحَقُّ وَوَعْدُكَ الصِّدْقُ وَيَأْبَى اللَّهُ إِلَّا أَنْ يُتِمَّ نُورَهُ صَلِّ وَسَلِّمْ وَبَارِكْ عَلَى مَنْ أَنْزَلْتَ عَلَيْهِ هَذَا سَيِّدِنَا وَمَوْلَانَا مُحَمَّدٍ وَآلِهِ وَصَحْبِهِ وَاجْعَلْ هَذِهِ الأَبْيَاتِ صَفَاءً لِقَائِلِهَا وَانْفَعْ بِهَا كُلَّ مَنِ اعْتَنَى بِهَا فِي الدَّارَيْنِ آمِينَ يَا رَبَّ الْعَالَمِينَ"
      ]
    },
    {
      "position": 2,
      "section": "title",
      "kind": "title",
      "bayt_number": null,
      "hemistichs": [
        "وَيَأْبَى اللَّهُ إِلَّا أَنْ يُتِمَّ نُورَهُ"
      ]
    },
    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "وَلَّى الأَذَى بِلَا وُصُولٍ لِي إِلَى",
        "سِوَايَ وَالْبَاقِي يَقُودُ لِي الإِلَى"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "يَقُودُ لِي كُنْ فَيَكُونُ لِلْجِنَانْ",
        "أَفْضَلَ سُولٍ بِمُطَهَّرِ الْجَنَانْ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "إِلَيَّ يَنْحُو الْخَيْرُ وَالصَّفَاءُ",
        "وَلِلْوَرَى مِنْ جِهَتِي شِفَاءُ"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "بَرَّأَنِي الْقُدُّوسُ مِنْ كُلِّ مَرَضْ",
        "وَلِي يَقُودُ أَمْنُ رَبِّيَ الْغَرَضْ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "إِلَيَّ يَنْقَادُ الرِّضَى وَالأَجْرُ",
        "وَالأَمْنُ فِي الْعَادَاتِ لَا لِي الزَّجْرُ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "إِلَى سِوَايَ جُمْلَةُ الْمَعَاصِي",
        "مَعَ الْمَكَارِهِ وَكُلُّ عَاصِ"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "لَا يَنْتَحِي إِلَيَّ غَيْرُ مَنْ يَتُوبْ",
        "أَوْ تَابَ وَاللَّهُ عَلَى مَنْ شَآ يَتُوبْ"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "لِوَجْهِهِ الْكَرِيمِ لِي يُوَجِّهُ",
        "كَرَمَهُ وَهْوَ لِي مُتَّجِهُ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "هُوَ الإِلَهُ وَهُوَ الرَّحْمَانُ",
        "وَهُوَ الرَّحِيمُ مِنْهُ لِي الأَمَانُ"
