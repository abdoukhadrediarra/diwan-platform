    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "لِي قَادَ وَاجِبًا وَمَنْدُوبًا وَمَا",
        "أَبَاحَ لِي وَلِي أَبَانَ الأَقْوَمَا"
