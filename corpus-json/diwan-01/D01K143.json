    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "نَوَيْتُ أَخْذَ كُلِّ مَا رَضِيتَ لِي",
        "بِكَ بِلَا تَرْكٍ وَمَا أَحْبَبْتَ لِي"
