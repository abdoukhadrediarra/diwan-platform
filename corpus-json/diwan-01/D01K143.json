      "hemistichs": [
        "أَمَّنَنِي الْجَمِيلُ خَيْرُ الْمُنْزِلِ",
        "مِنْ ضَرَرِ الأَعْدَاءِ وَالتَّزَلْزُلِ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "نَوَيْتُ ذِكْرَهُ بِخَيْرِ مُنْزَلِ",
        "وَغَيْرِهِ مَعَ الْقِرَى وَالنُّزُلِ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "نَوَيْتُ شُكْرَ مَنْ يُصَفِّي كَلْكَلِي",
        "وَبَدَنِي وَمَشْرَبِي وَمَأْكَلِي"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "أَسْأَلُهُ إِخْرَاجَهُ فِي الْعَجَلِ",
        "مِنِّي دَوَاعِيَ الْأَذَى وَالْخَجَلِ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "مَدَّ إِلَيَّ مَا يُصَفِّي قِبَلِي",
        "وَمَا يَفِي مِنْ قِبَلِي تَقَبَّلِ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
