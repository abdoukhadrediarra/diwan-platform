      "hemistichs": [
        "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ صَلَّى اللَّهُ عَلَى سَيِّدِنَا مُحَمَّدٍ وَعَلَى آلِهِ وَصَحْبِهِ وَسَلَّمَ تَسْلِيمًا إِنَّ هَذَا لَهُوَ الْقَصَصُ الْحَقُّ"
      ]
    },
    {
      "position": 2,
      "section": "title",
      "kind": "title",
      "bayt_number": null,
      "hemistichs": [
        "إِنَّا نَحْنُ نَزَّلْنَا الذِّكْرَ وَإِنَّا لَهُ لَحَافِظُونَ"
      ]
    },
    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "إِلَى فُؤَادِي وَيَدِي وَوَطَنِي",
        "وُجُودُ رَبِّي قَادَ ذِكْرَ عَطَنِي"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "نَفَى لِغَيْرِي ذُو الْبَقَاءِ وَالْقِدَمْ",
        "إِلَى سِوَى عُمْرِيَ كُلَّ مَا صَدَمْ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "نَفَى لِغَيْرِيَ اللَّهُ ذُو الْمُخَالَفَهْ",
        "ضُرِّي وَمَدَّ الأَمْرَ لَنْ أُخَالِفَهْ"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "أَنَالَنِي مُغْنٍ لَهُ الْقِيَامُ",
        "بِالنَّفْسِ مَا لَمْ يَنْحَهُ الأُيَامُ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "نَفَى الَّذِي لَهُ الْبَرَايَا وَحْدَهْ",
        "لِغَيْرِهِ الْعَكْسَ وَضِدَّ الْوَحْدَهْ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "حِبَاءُ ذِي الْقُدْرَةِ وَالإِرَادَهْ",
        "خَلَّدَ لِي مَا مِنْهُ لِي أَرَادَهْ"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "نَفْعُ الَّذِي الْعِلْمُ مَعَ الْحَيَاةِ",
        "لَهُ يَقُودُ لِي مُنَى حَيَاتِي"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "نَفْعُ الَّذِي السَّمْعُ مَعَ الْبَصَرِ لَهْ",
        "لِي قَادَ نَفْعَ عُمْرِي وَالْعُمْرُ لَهْ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "زِنْتُ لِذِي الْكَلَامِ مَا قَدْ رَفَعَهْ",
        "لَهُ وَجُنْدُهُ بِهِ مُنْتَفِعَهْ"
      ]
    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "زِنْتُ لِقَادِرٍ مُرِيدٍ عَالِمْ",
        "حَيٍّ سَمِيعٍ مَا كَفَانِي الظَّالِمْ"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "لَدَى بَصِيرٍ مُتَكَلِّمٍ لِيَا",
        "ذِكْرٌ وَشُكْرٌ بِهِمَا كَانَ لِيَا"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "نَفَى الَّذِي دَلَّ عَلَى الْوُجُودِ",
        "الْخَلْقَ ضَرِّي وَحَمَى بِالْجُودِ"
      ]
    },
    {
      "position": 15,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 13,
      "hemistichs": [
        "إِنَّ الَّذِي تَأْثِيرَهُ لَا يُشْرِكُ",
        "فِيهِ سِوَاهُ قَادَنِي لَا أُشْرِكُ"
      ]
    },
    {
      "position": 16,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 14,
      "hemistichs": [
        "إِنَّ الَّذِي حُدُوثُ غَيْرِهِ ثَبَتْ",
        "وَثَبَّتَ الْقِدَمُ قَتْلِي لِي كَبَتْ"
      ]
    },
    {
      "position": 17,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 15,
      "hemistichs": [
        "لَا يَنْتَحِي مَا لَا يَلِيقُ أَبَدَا",
        "لِي وَعُمْرِيَ إِلَهِيَ عَبَدَا"
      ]
    },
    {
      "position": 18,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 16,
      "hemistichs": [
        "ذَلِكَ فَضْلُ اللَّهِ نِعْمَ اللَّهُ",
        "قَطْعًا وَلَا إِلَهَ إِلَّا اللَّهُ"
      ]
    },
    {
      "position": 19,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 17,
      "hemistichs": [
        "كَلَامُ مَنْ أَرْسَلَ خَيْرَ مُرْسَلِ",
        "عَلَيْهِ صَلَّى اللَّهُ مُعْطِي عَسَلِ"
      ]
    },
    {
      "position": 20,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 18,
      "hemistichs": [
        "رُسُلُهُ عَلَيْهِمُ الصَّلَاةُ",
        "مَعَ سَلَامِهِ لَهُمْ صِلَاتُ"
      ]
    },
    {
      "position": 21,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 19,
      "hemistichs": [
        "وَجَبَ صِدْقٌ وَأَمَانَةٌ مَعَا",
        "تَبْلِيغُهُمْ لَهُمْ وَكُلٌّ جَمَعَا"
      ]
    },
    {
      "position": 22,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 20,
      "hemistichs": [
        "إِلَيْهِمُ الْكَذِبُ وَالْخِيَانَهْ",
        "لَا يَنْتَحِي كَالْكَتْمِ خُذْ بَيَانَهْ"
      ]
    },
    {
      "position": 23,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 21,
      "hemistichs": [
        "نَفَى الَّذِي قَدْ جَادَ بِالْفَطَانَهْ",
        "لَهُمْ لِغَيْرِهِمْ تِهِ صِيَانَهْ"
      ]
    },
    {
      "position": 24,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 22,
      "hemistichs": [
        "نَفَعُهَمْ بِمَا يَكُونُ أَبَدَا",
        "عَرَضُ إِنْسَانٍ يُعِينُ الْعُبَّدَا"
      ]
    },
    {
      "position": 25,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 23,
      "hemistichs": [
        "إِيمَانُ رُسْلِ اللَّهِ وَالأَمْلَاكِ",
        "وَقَدَرِهِ الْعَاصِمِ مِنْ هَلَاكِ"
      ]
    },
    {
      "position": 26,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 24,
      "hemistichs": [
        "لِهَذِهِ ضُمَّ كَأَنْبِيَائِهِ",
        "وَالْيَوْمِ وَالْكُتُبِ عَلَى ضِيَائِهِ"
      ]
    },
    {
      "position": 27,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 25,
      "hemistichs": [
        "هَدَمْتُ بِالْحَقِّ بِنَاءَ مَنْ كَفَرْ",
        "وَمَنْ قَلَى وَمَنْ وَشَى وَمَنْ نَفَرْ"
      ]
    },
    {
      "position": 28,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 26,
      "hemistichs": [
        "لِلَّهِ قَدْ أَوْصَلْتُ عِنْدَ الْمُزْبِدِ",
        "تَوْحِيدَهُ الْمُخْزِيَ مَنْ لَمْ يَعْبُدِ"
      ]
    },
    {
      "position": 29,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 27,
      "hemistichs": [
        "حَاوَلْتُ شُكْرَ اللَّهِ فِي تُرَابِي",
        "وَقَبْلُ عَنِّي قَدْ مَحَا اغْتِرَابِي"
      ]
    },
    {
      "position": 30,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 28,
      "hemistichs": [
        "إِلَى يَدِي وَكَلْكَلِي وَجَسَدِي",
        "قَادَ الْكِتَابَ مَنْ كَفَانِي حُسَّدِي"
      ]
    },
    {
      "position": 31,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 29,
      "hemistichs": [
        "إِلَى دُيُورِي وَمَكَانِي وَالْوَطَنْ",
        "قَدْ قَادَ جُنْدَهُ مُنَوِّرُ الْعَطَنْ"
      ]
    },
    {
      "position": 32,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 30,
      "hemistichs": [
        "فَازَتْ قِلَامِي وَمِدَادِي وَالْبَدَنْ",
        "وَلَيْسَ يَنْحُو لِحَيَاتِيَ دَدَنْ"
      ]
    },
    {
      "position": 33,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 31,
      "hemistichs": [
        "ظُلْمِيَ امَّحَى بِنَصْرِ قَاهِرٍ كَسَرْ",
        "سِلَاحَ مَنْ كَانَ يُبَاهِي فَانْكَسَرْ"
      ]
    },
    {
      "position": 34,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 32,
      "hemistichs": [
        "وَلَّتْ عِدَايَ لِسِوَايَ صَاغِرِينْ",
        "وَكَافِرِينَ فَاسِقِينَ خَاسِرِينْ"
      ]
    },
    {
      "position": 35,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 33,
      "hemistichs": [
        "نَوَّرَ قَلْبِي مَالِكِي وَعَطَنِي",
        "وَذِكْرُهُ الْحَكِيمُ صَانَ وَطَنِي"
      ]
    }
  ]
