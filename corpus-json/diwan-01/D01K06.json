    },
    {
      "position": 18,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 16,
      "hemistichs": [
        "يَسُوقُ سَرْمَدًا لِغَيْرِي اللَّهُ",
        "ضُرًّا وَلَا إِلَهَ إِلَّا اللَّهُ"
