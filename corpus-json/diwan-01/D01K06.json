    },
    {
      "position": 20,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 18,
      "hemistichs": [
        "إِلَى سِوَايَ كُلُّ مَنْ لَمْ يَهْوَنِي",
        "وَلِسِوَى اللَّهِ الْعَلِي الْمُكَوِّنِ"
