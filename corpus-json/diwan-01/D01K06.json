    {
      "position": 27,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 25,
      "hemistichs": [
        "مِنْ غَيْرِ بِشْرٍ وَمِنَ الشَّيْطَانِ",
        "أَعَاذَنِي مَنْ جَادَ بِالْأَوْطَانِ"
