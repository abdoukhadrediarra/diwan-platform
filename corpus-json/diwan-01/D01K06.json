      "section": "matn",
      "kind": "bayt",
      "bayt_number": 22,
      "hemistichs": [
        "رَدَدْتُ أَعْدَاءَ الْإِلَهِ بِالنَّبِي",
        "وَلَا يَزَالُ مُبْغِضِي بِمُذْنِبِ"
