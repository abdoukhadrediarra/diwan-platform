      ]
    },
    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "أَعَاذَنِي الْبَاقِي مِنَ الشَّيْطَانِ",
        "عِنْدَ مَمَرِّيَ وَفِي الْأَوْطَانِ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "عِبَادَتِي ابْتَدَأْتُ بِسْمِ اللَّهِ",
        "وَهْوَ كَفَانِيَ ذَوِي الْمَلَاهِي"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "وَجَّهْتُ كُلَّ الْحَمْدِ وَالشُّكُورِ",
        "لِلْمَالِكِ الرَّحْمَانِ وَالشَّكُورِ"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "ذَكَى الرَّحِيمُ بِالنَّبِي رَجِيمِي",
        "وَآلِهِ وَصَحْبِهِ النُّجُومِ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "بِاللَّهِ فَارَقْتُ نَصَارَى جِيوَلِ",
        "وَغَيْرِهِ قَطْعًا بِلَا تَنَاوُلِ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "إِلَى النَّبِي وَجَّهْتُ قَبْلُ فِي انْدَرِ",
        "مَا قَدْ كَفَانِيَ الْعِدَى كَالْكَدَرِ"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "لِلْمُنْتَقَى وَجَّهْتُ فِي انْدَكَارُ",
        "ذِكْرًا بِهِ قَدْ كُبْكِبَ الْمَكَّارُ"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "لِلْمُجْتَبَى وَجَّهْتُ فِي السَّفِينَهْ",
        "قَبْلُ ثَنَآ يَخْلُدُ فِي الْمَدِينَهْ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "أَخْلَصْتُ خِدْمَتِي لَدَى كُنَاكِرِ",
        "لِلْمُصْطَفَى الْمَاحِي بِلَا مَنَاكِرِ"
      ]
    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "هَرَبَ مِنِّي قَبْلُ فِي كَرَمْبَسَا",
        "مُبَارِزِي وَلِسِوَايَ حُبِسَا"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "مَلَّكَنِي الْمَالِكُ عِنْدَ دَاوُمِ",
        "مَا قَدْ كَفَانِيَ عِدَى تَسَاوُمِ"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "نَفَعَنِي النَّافِعُ فِي لِبَرْوَلِ",
        "بِمَا بِهِ يَغْبِطُنِي كُلُّ وَلِي"
      ]
    },
    {
      "position": 15,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 13,
      "hemistichs": [
        "إِلَى النَّبِيِّ وَجَّهْتُ عِنْدَ بَافَلِ",
        "قَبْلُ بِمَا بِهِ أَنَارَ مَحْفَلِي"
      ]
    },
    {
      "position": 16,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 14,
      "hemistichs": [
        "لِلْمُنْتَقَى وَجَّهْتُ فِي كَبْلَبِسَا",
        "مَا قَدْ كَفَانِيَ عَدُوًّا حُبِسَا"
