    },
    {
      "position": 17,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 15,
      "hemistichs": [
        "شَقَّ عَلَى الشَّيْطَانِ عِنْدَ كَلْوَى",
        "كَوْنِي خَدِيمَ مَنْ كَفَانِي الْبَلْوَى"
