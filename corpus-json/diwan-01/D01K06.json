    },
    {
      "position": 19,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 17,
      "hemistichs": [
        "طَوَافُ كُلِّ مَنْ عَلَيَّ أَنْكَرَا",
        "عِنْدَ الْإِلَهِ وَالنَّبِي لَنْ يُشْكَرَا"
