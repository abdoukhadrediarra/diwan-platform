        "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ وَصَلَّى اللَّهُ عَلَى سَيِّدِنَا مُحَمَّدٍ وَآلِهِ وَصَحْبِهِ وَسَلَّمَ تَسْلِيمًا وَوَهَبَ لِي قَوْلَهُ تَعَالَى"
      ]
    },
    {
      "position": 2,
      "section": "title",
      "kind": "title",
      "bayt_number": null,
      "hemistichs": [
        "وَكَانُوا يَتَّقُونَ"
      ]
    },
    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "وَجَّهْتُ كُلِّيَ لِخَالِقِ الْوَرَى",
        "وَقَادَ لِي بِمُنْتَقَاهُ السُّوَرَا"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "كُلِّيَّتِي جَعَلْتُهَا لِلَّهِ",
        "وَدِيعَةً وَصَانَنِي عَنْ لَاهِ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "إِذَا تَلَوْتُ ذِكْرَ رَبِّي فَرَّا",
        "لِي فَضْلُهُ وَفِي فُؤَادِي قَرَّا"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "نَفَى سِوَى الرِّضْوَانِ عَنْ حَيَاتِي",
        "مَنْ قَادَنِي إِلَيْهِ بِالآيَاتِ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "وَلَّتْ مَنَاهِي مَالِكِي لِغَيْرِي",
        "وَلِي الأَوَامِرُ انْتَحَتْ بِالْخَيْرِ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "اللَّهُ طَهَّرَ فُؤَادِي وَالْجَسَدْ",
        "مِنْ كُلِّ عِصْيَانٍ وَأَغْنَى عَنْ حَسَدْ"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "يَقُودُ لِي الأَكْرَمُ عِلْمًا بِحَلَالْ",
        "يُزَحْزِحَانِ الْفَقْرَ مَعْ كُلِّ ضَلَالْ"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "تُرْسِي عَنِ الْعُصَاةِ وَالْمَعَاصِي",
        "حِفْظٌ لِغَيْرِي ذَبَّ كُلَّ عَاصِ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "تُرْسِي عَنِ النِّيرَانِ وَالْمَنَاهِي",
        "عِصْمَةُ بَاقٍ آمِرٍ وَنَاهِ"
      ]
    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "قَوْلِي وَفِعْلِي وَاعْتِقَادِي صُرِفَتْ",
        "لِلَّهِ بِالْقُرْآنِ وَهْيَ انْصَرَفَتْ"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "وَقَانِيَ الْبَاقِي ارْتِيَابًا كَارْتِدَادْ",
        "وَقَادَنِي إِلَى الْجِنَانِ بِوِدَادْ"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "نَفَعَنِي بِالذِّكْرِ خَالِقُ الْوَرَى",
        "وَرَمَّ سَعْيِيَ وَكُلِّي نَوَّرَا"
      ]
    },
    {
      "position": 15,
      "section": "khatima",
      "kind": "prose",
      "bayt_number": null,
      "hemistichs": [
        "وَجَعَلَ حَرَكَاتِي وَسَكَنَاتِي وَأَنْفَاسِي وَأَعْرَاضِي وَأَغْرَاضِي أَنْفَعَ التَّقْوَى وَأَحْسَنَ التَّقْوَى وَأَوْصَلَ إِلَيَّ فِي قَصِيدَتِي هَذِهِ أَثْمَانَ كُلِّ مَا بَاعَهُ عَنِّي وَاشْتَرَاهُ مِنِّي بِلَا فَسْخٍ وَلَا إِقَالَةٍ وَلَا مَكْرٍ وَلَا غُرُورٍ وَلَا اسْتِدْرَاجٍ وَلَا آفَةٍ وَلَا كَدَرٍ أَبَدًا آمِينْ يَا رَبَّ الْعَالَمِينَ سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ وَسَلَامٌ عَلَى الْمُرْسَلِينَ وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"
      ]
    }
