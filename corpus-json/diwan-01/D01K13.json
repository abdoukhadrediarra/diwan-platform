      "bayt_number": 1,
      "hemistichs": [
        "بَانَ لِمَنْ لَهُ حِجًى أَنَّ الرَّسُولْ",
        "صَلَّى عَلَيْهِ مَنْ بِهِ يَحْبُو بِسُولْ"
      ]
    },
    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "سَيَّرَنِي إِلَى الْبِلَادِ النَّائِيَهْ",
        "وَقَادَ لِي مُخْجِلَ سَمْعِ السَّارِيَهْ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "مَدَحَهُ كُلِّي بِلَا اسْتِثْنَاءِ",
        "لِوَجْهِ مَنْ بِهِ مَحَا عَنَائِي"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "إِلَى النَّبِيِّ الْمُصْطَفَى عِنْدَ انْدَرِ",
        "وَجَّهْتُ مَدْحًا قَدْ أَزَالَ كَدَرِي"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "لِلْمُنْتَقَى وَجَّهْتُ فِي اندَكَارُ",
        "مَدْحًا بِهِ فَارَقَنِي الْمَكَّارُ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "لِلْمُجْتَبَى مَدْحِي لَدَى كُنَاكِرِ",
        "كَمَا هَدَانِيَ بِلَا مَنَاكِرِ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "هَدَانِيَ الَّذِي عَدُوِّي حَبَسَا",
        "عَنِّي بِمَدْحِ الْبَرِّ فِي كَرَمْبَصَا"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "أَغْنَانِيَ الْمُغْنِي عَنِ التَّسَاوُمِ",
        "بِهِ وَبِالْمُخْتَارِ عِنْدَ دَاوُمِ"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "لِي قَادَ مَا فَرَّ لَهُ كُلُّ وَلِي",
        "بِمَدْحِ خَيْرِ الْخَلْقِ فِي لِبَرْوَلِ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "رَضِيَ مَنْ لِي جَادَ بِالذَّخَائِرِ",
        "عَنِّي بِخِدْمَتِي لَدَى الْجَزَائِرِ"
      ]
    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "حَمِدْتُ مَنْ بِالْمُنْتَقَى حَمَانِي",
        "عَنْ جُمْلَةِ الْأَكْدَارِ فِي زَمَانِي"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "مَلَّكَنِي الرَّحْمَانُ مَا أَغْنَانِي",
        "بِأَجْرِ بَاقٍ بَاسِطٍ مَنَّانِ"
