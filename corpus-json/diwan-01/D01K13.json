    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 13,
      "hemistichs": [
        "إِلَى النَّبِي لِوَجْهِهِ أَمْدَاحِي",
        "وَبِالْمُنَى مَلَأَ لِي أَقْدَاحِي"
