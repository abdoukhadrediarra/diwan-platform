      "kind": "bayt",
      "bayt_number": 19,
      "hemistichs": [
        "يَشْكُرُ كُلِّي اللَّهُ لِلْجِنَانِ",
        "وَبِالرِّضَى عَنِ الْأَذَى أَغْنَانِي"
