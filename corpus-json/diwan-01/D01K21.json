        "لِي قَادَهُ الْمُغْنِي بِذَلِكَ الْكِتَابْ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "إِذَا تَلَوْتُ خَيْرَ ذِكْرٍ فَرَّا",
        "لِغَيْرِ نَحْوِي ذُو الشَّقَا مُغْتَرَّا"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "لِيَ يَقُودُ فِي تَلَازُمِي الْبُشَرْ",
        "بِغَيْرِ مَكْرٍ وَأَذًى رَبُّ الْبَشَرْ"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "كِتَابَ رَبِّي إِنَّكَ الْكِتَابُ",
        "وَفِيكَ قَالَ ذَلِكَ الْكِتَابُ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "أَنْتَ خَلِيلِي أَنْتَ لِيَ الْحَبِيبُ",
        "لِي قُدْتَ مَا لَمْ يَدْرِهِ لَبِيبُ"
