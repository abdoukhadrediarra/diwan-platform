      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "فَاقَ جَمِيعَ الأَنْبِيَآ وَالرُّسُلِ",
        "سَيِّدُنَا أَحْمَدُ حِبُّ الْمُرْسِلِ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "قَدَّمَ أَحْمَدَ عَلَى الْكِرَامِ",
        "مُسْرٍ بِهِ لِلْكُلِّ بِاحْتِرَامِ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "دَرَجَةُ الْعَبْدِ الرَّسُولِ أَحْمَدَا",
        "صَيَّرَتِ الأَخْيَارَ غُرّاً حُمَّدَا"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "جَادَ النَّبِي يَوْمَ أَلَسْتُ بِجَوَابْ",
        "لِلْغُرِّ فَالْكُلُّ أَجَابَ بِصَوَابْ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "أُعْجَزَ كُلَّ وَالِدٍ وَوَالِدَهْ",
        "أَحْمَدُنَا الَّذِي عُلَاهُ خَالِدَهْ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "آيَاتُ أَحْمَدَ حَوَتْ آيَاتِ مَنْ",
        "مَضَوْا وَمَنْ يَأْتِي وَفَاقَتْ ذَا الزَّمَنْ"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "كِتَابُهُ كُتُبَ رُسْلِ الْمُنْزِلِ",
        "حَوَى وَجَادَ بِالْقِرَى وَالنُّزُلِ"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "مُحَمَّدٌ عَلَيْهِ أَفْضَلُ سَلَامْ",
        "مُقَدَّمٌ بِخَيْرِ فِعْلٍ وَكَلَامْ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "بِدَايَةُ الْمَاحِي نِهَايَةُ الْخِيَارْ",
        "فَضَّلَهُ عَلَى الْوَرَى ذُو الاِخْتِيَارْ"
      ]
    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "شَهِدَ كُلُّ سَيِّدٍ يُخْتَارُ",
        "بِأَنَّ أَحْمَدَ هُوَ الْمُخْتَارُ"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "يَنْقَادُ لِلْمُخْتَارِ مَا سِوَاهُ",
        "فَرَّ لَهُ فَضْلاً وَقَدْ حَوَاهُ"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "رَسُولُنَا فَاقَ جَمِيعَ الرُّسُلِ",
        "وَالأَنْبِيَآ وَهْوَ حَبِيبُ الْمُرْسِلِ"
      ]
    }
  ]
