      "bayt_number": 1,
      "hemistichs": [
        "يَسُرُّ نَحْوِي وَعَرُوضِي الْمُنْتَقَى",
        "عَلَيْهِ تَسْلِيمَاتُ هَادٍ انْتَقَى"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "سَرَّ رَسُولَ اللَّهِ عُمْرِي صَلَّى",
        "مُسَلِّمًا عَلَيْهِ بَاقٍ جَلَّا"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "تَسُرُّ أَفْضَلَ الْوَرَى حَيَاتِي",
        "بِخِدْمَتِي لَهُ وَلِلآيَاتِ"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "بَانَ لِكُلِّ مَنْ لَهُ مَعْقُولُ",
        "فِي كَلْكَلِيَ الْمَنْقُولُ وَالْمَعْقُولُ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "شَهِدَتِ الشَّرِيعَةُ الْمُطَهَّرَهْ",
        "لِيَ مَعَ الْحَقِيقَةِ الْمُنَوَّرَهْ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "رَافَقَنِي الظَّاهِرُ فِي مَسِيرِي",
