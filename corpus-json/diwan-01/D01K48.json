      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "نَفَى لِغَيْرِ ذَاتِيَ الْبَاقِي الْقَدِيمْ",
        "مَكَارِهَ الدَّارَيْنِ بِشْرِيَ يَدُومْ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
