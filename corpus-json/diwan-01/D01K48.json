        "وَجَادَ لِي الْخَبِيرُ بِالْغُيُوبِ"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "دَعَانِيَ الْبَاقِي إِلَى الشُّكُورِ",
        "وَلَمْ يَزَلْ بِنَافِعٍ شَكُورِ"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "أَزْكَى سَلَامَيْ مَنْ كِتَابَتِي انْتَقَى",
        "عَلَى النَّبِيِّ الْعَرَبِيِّ الْمُنْتَقَى"
      ]
    },
    {
      "position": 15,
      "section": "khatima",
      "kind": "prose",
      "bayt_number": null,
      "hemistichs": [
        "بِنِعْمَةٍ مِنَ اللَّهِ وَفَضْلٍ لَمْ يَمْسَسْهُمْ سُوءٌ وَاتَّبَعُوا رِضْوَانَ اللَّهِ وَاللَّهُ ذُو فَضْلٍ عَظِيمٍ فِيمَا مَضَى قَبْلَ يَوْمِ خَطِّي هَاتَيْنِ الْقَصِيدَتَيْنِ اللَّتَيْنِ أَمَرَنِي بِأَنْ أَشْكُرَهُ بِهِمَا وَاللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ"
      ]
