      ]
    },
    {
      "position": 2,
      "section": "title",
      "kind": "title",
      "bayt_number": null,
      "hemistichs": [
        "حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ"
      ]
    },
    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "حَجَبَنِي اللَّهُ عَنِ الأَسْوَاءِ",
        "وَإِنَّنِي حَاجِيَ ذُو احْتِوَاءِ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "سُبْحَانَ مَنْ أَطْلَقَنِي بِتَوْسِعَهْ",
        "إِلَى الْجِنَانِ ذَا أَمَانٍ وَسَعَهْ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "بَارَكَ لِي النَّافِعُ فِي أَنْفَاسِي",
        "مُرْتَضِيًا عَنِّي بِلَا عِفَاسِ"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "نَفَى لِغَيْرِيَ الْعِدَى وَالْمَرَضَا",
        "وَلِي يَقُودُ بِرِضَاهُ الْغَرَضَا"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "أَلَانَ لِي الْقُلُوبَ قَادَ لِي السُّوَرْ",
        "وَحَبَّذَا الْخَالِقُ مُحْسِنُ الصُّوَرْ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "اللَّهُ خَيْرُ مَنْ هَدَى وَكَشَفَا",
        "وَخَيْرُ مَنْ يُعْطِي الدَّوَاءَ وَالشِّفَآ"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "لِلَّهِ خَطِّي وَحَمَانِي عَنْ طَبِيبْ",
        "عَبْدًا لَهُ خِلّاً لَهُ خَيْرَ حَبِيبْ"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "لَسْتُ أَرَى سِوَاكَ فِي لَيَادِ",
        "يَا قَائِدًا لِي أَفْضَلَ الْأَيَادِ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "أَكْرَمْتَنِي إِكْرَامَ بَاقٍ وَجَمِيلْ",
        "فَلِسِوَى رِضَاكَ رَبِّ لَا أَمِيلْ"
      ]
    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "هَبْ لِي دَوَامَ الْحُبِّ وَالرِّضَاءِ",
        "يَا مَنْ كَفَانِي كَدَرَ الْقَضَاءِ"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "وَهَبْتَ لِي الرِّضَاءَ وَالْمَحَبَّهْ",
        "وَبِي تُبَاهِي جُمْلَةَ الأَحِبَّهْ"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "نَفَعْتَنِي فِي الْحَالِ وَالْمَآلِ",
        "أَغْنَيْتَنِي بِكَ عَنِ السُّؤَالِ"
      ]
    },
    {
      "position": 15,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 13,
      "hemistichs": [
        "عَلَّمْتَنِي تَعْلِيمَ مَنْ لَا يَخْفَى",
        "عَلَيْهِ شَيْءٌ كُنْتَ لِي بِالأَخْفَى"
      ]
    },
    {
      "position": 16,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 14,
      "hemistichs": [
        "مَلَّكْتَنِي تَمْلِيكَ مَنْ لَا يُسْأَلُ",
        "عَنْ فِعْلِهِ يَا رَبِّ أَنْتَ الْمَوْئِلُ"
      ]
    },
    {
      "position": 17,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 15,
      "hemistichs": [
        "أَذْهَبْتَ كُلَّ مَا يُؤَدِّي لِنَكَدْ",
        "إِلَى سِوَى ذَاتِي وُقِيتُ كُلَّ كَدّ"
      ]
    },
    {
      "position": 18,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 16,
      "hemistichs": [
        "لَمْ يَنْحُنِي إِلَى دُخُولِيَ الْجِنَانْ",
        "شَيْءٌ يُؤَدِّينِي إِلَى ضَيْقِ الْجَنَانْ"
      ]
    },
    {
      "position": 19,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 17,
      "hemistichs": [
        "وَالَيْتَنِي أَبْقَيْتَنِي لَطَفْتَ بِي",
        "لِي قُدْتَ سِرّاً نَافِعًا لَمْ يُكْتَبِ"
      ]
    },
    {
      "position": 20,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 18,
      "hemistichs": [
        "كَفَيْتَنِي الْمُسْتَهْزِئِينَ كُنْتَ لِي",
        "بِمَا يَسُرُّنِي وَسِرِّي صُنْتَ لِي"
      ]
    },
    {
      "position": 21,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 19,
      "hemistichs": [
        "يَسَّرْتَ لِي الْقُرْآنَ وَالْعُلُومَا",
        "تَيْسِيرَ مَنْ لَمْ يُرِنَا الْكُلُومَا"
      ]
    },
    {
      "position": 22,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 20,
      "hemistichs": [
        "لَمْ يَنْحُنِي شَيْءٌ مِنَ الأَسْوَاءِ",
        "وَإِنَّنِي سُؤْلِي ذُو احْتِوَاءِ"
      ]
    },
    {
      "position": 23,
      "section": "khatima",
      "kind": "prose",
      "bayt_number": null,
      "hemistichs": [
        "هِبَةَ مَنْ يَهَبُ مَا يَشَاءُ بِلَا حِسَابٍ آمِينْ"
      ]
    }
  ]
