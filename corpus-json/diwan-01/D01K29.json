      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "أَذْهَبَ عَنِّيَ اللَّعِينَ اللَّهُ",
        "فَقُلْتُ لَا إِلَهَ إِلَّا اللَّهُ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "لَهُ خِطَابِي وَكَفَانِيَ اللَّعِينْ",
        "لَكَ شُكُورِي يَا حَفِيظُ يَا مُعِينْ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "حَفِيظُ زِدْنِي عِصْمَةً وَحِفْظَا",
        "وَهَبْ لِيَ الْمَعْنَى وَهَبْ لِي اللَّفْظَا"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "يَا حَيُّ يَا قَيُّومُ زَحْزِحِ اللَّعِينْ",
        "عَنِ التَّوَجُّهِ إِلَيَّ لِتُعِينْ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "يَقِينِيَ الْيَقِينُ إِمْسَاكَ لَيَادْ",
        "لَمْ تَرْضَهُ لِي إِنَّكَ الْمُعْطِي الْأَيَادْ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "أَذْهَبْتَ عَنِّيَ اللَّعِينَ سَرْمَدَا",
        "بِجَاهِ أَفْضَلِ الْبَرَايَا أَحْمَدَا"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "لِي لَا تُوَجِّهْ مَا يَكُونُ مُفْسِدَا",
        "لِوَجْهِكَ الْكَرِيمِ أَبْقِ الْجَسَدَا"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "قَلْبِي وَرُوحِي أَبْقِ أَنْتَ الْبَاقِي",
        "لَكَ إِلَهِي السَّبْعُ كَالطِّبَاقِ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "يَا حَيُّ يَا قَيُّومُ كُفَّ كُلَّ مَا",
        "يَسُوءُ عَنْ تَوَجُّهٍ لِي مُسْلِمَا"
      ]
    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "يَا حَيُّ يَا قَيُّومُ يَا مَنْ أَبْقَى",
        "كُلِّيَّتِي وَلِي وَهَبْتَ سَبْقَا"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "وَجَّهْتَ لِي أَثْمَانَ مَا قَدْ بِعْتُ",
        "وَكُلَّ مَا لَمْ تَرْضَ لِي قَطَعْتُ"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "مَحَوْتَ ضُرِّي أَبَدًا يَا اللَّهُ",
        "يَا حَيُّ يَا قَيُّومُ أَنْتَ اللَّهُ"
      ]
    }
  ]
