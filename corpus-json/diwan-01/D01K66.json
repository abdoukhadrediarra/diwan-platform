        "فِي خَلْقِ مَنْ قَادَ لَهُ كُنْ فَيَكُونْ"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
