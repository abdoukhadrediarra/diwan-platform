        "حَقِيقَةَ التَّوْحِيدِ وَهْوَ سَمِعَا"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "أَحْمَدُهُ مُوَحِّدًا وَأَشْكُرُهْ",
        "بِلَا أَذًى وَبِالْكِتَابِ أَذْكُرُهْ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "كَرَّمَنِي بِهِ وَبِالْمُشَفَّعِ",
        "مَنْ مَدْحُهُ قَدْ صَانَنِي بِالأَنْفَعِ"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "نَفَعَنِي بِالْمُصْطَفَى وَبِالصِّحَابِ",
        "مَنْ حُبُّهُمْ صَيَّرَنِي كَذِي اصْطِحَابِ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "أَشْكُرُهُ عَلَى الْجَمِيعِ وَعَلَى",
        "أَمْلَاكِهِ مَنْ حُبُّهُمْ يُنْمِي الْعُلَى"
