      "bayt_number": null,
      "hemistichs": [
        "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ وَصَلَّى اللَّهُ عَلَى سَيِّدِنَا مُحَمَّدٍ وَآلِهِ وَصَحْبِهِ وَسَلَّمَ تَسْلِيمًا وَأَشْهَدَ جُنْدَهُ الْغَالِبِينَ بِأَنَّهُ سُبْحَانَهُ أَثْبَتَ لِنَاظِمِ هَذِهِ الْقَصِيدَةِ قَصِيدَتَهُ الَّتِي أَخَذَهَا مِنْ قَوْلِهِ تَبَارَكَ وَتَعَالَى وَيُثَبِّتُ وَعِنْدَهُ أُمُّ الْكِتَابِ بِقَدْرِ عَظَمَةِ ذَاتِهِ بِلَا مَحْوٍ أَبَدًا وَاللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ"
      ]
    },
    {
      "position": 2,
      "section": "title",
      "kind": "title",
      "bayt_number": null,
      "hemistichs": [
        "وَيُثَبِّتُ وَعِنْدَهُ أُمُّ الْكِتَابِ"
      ]
    },
    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "وَلَّى اللَّعِينُ وَالْمَكَارِهُ مَعَا",
        "لِغَيْرِ نَحْوِي لِيَ سُؤْلِي انْجَمَعَا"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "يَثْبُتُ عِنْدِيَ الْكِتَابُ وَالْحَلَالْ",
        "لَمْ يَنْحُنِي ذُو غَضَبٍ أَوْ ذُو ضَلَالْ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "ثَبَتَ كَوْنِي مُؤْمِنًا وَمُسْلِمَا",
        "وَمُحْسِنًا جَاهَدْتُ مَنْ لَمْ يُسْلِمَا"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "بَرَّأَنِي الْبَاقِي مِنَ الشَّقَاءِ",
        "وَجَادَ لِي بِالرَّفْعِ ذَا ارْتِقَاءِ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "بَرِأْتُ مِنْ كُفْرٍ وَمِنْ فِسْقٍ وَمِنْ",
        "شِرْكٍ وَرَبِّي بِفَلَاحِي لِي ضَمِنْ"
