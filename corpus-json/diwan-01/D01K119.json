      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "عَبَدْتُهُ عِنْدَ عِدَاهُ مُدَّهْ",
        "بِفَيْضِهِ الَّذِي إِلَيَّ مَدَّهْ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "نَفَعَنِي فِي الْبَرِّ وَالْبَحْرِ وَفِي",
        "السِّرِّ وَالْجَهْرِ مَعَ الْهَادِي الْوَفِي"
