    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "تَوْفِيقُهُ قَادَ لَهُ كُلِّيَّتِي",
        "عَقْدِي وَقَوْلِي عَمَلِي وَنِيَّتِي"
