    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "وَجَّهَ أَشْخَاصَ عِدَايَ وَالضَّرَرْ",
        "إِلَى سِوَايَ مَنْ حَمَانِي عَنْ شَرَرْ"
