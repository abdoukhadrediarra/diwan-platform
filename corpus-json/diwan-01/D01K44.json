      ]
    },
    {
      "position": 2,
      "section": "title",
      "kind": "title",
      "bayt_number": null,
      "hemistichs": [
        "وَاللَّهُ وَلِيُّ الْمُؤْمِنِينَ"
      ]
    },
    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "وَاجَهَنِي رَبُّ الأَرَاضِي وَالسَّمَا",
        "إِلَى جِنَانِهِ بِمَا لِي قَسَمَا"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "أَذْهَبَ رَبُّ الأَرْضِ وَالسَّمَاءِ",
        "لِغَيْرِيَ الأَكْدَارَ ذَا نَمَاءِ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "لَمْ يَنْحُنِي غَيْرُ رِضَاهُ لِلْجِنَانْ",
        "وَعُمُرِيَ صَفَّى وَطَيَّبَ الْجَنَانْ"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "لَهُ شُكُورِي بَعْدَ حَمْدٍ خَلَدَا",
        "وَقَادَ لِي مَا اخْتَصَّنِي وَأَخْلَدَا"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "اللَّهُ رَافِعٌ جَنَابِي بِالسُّوَرْ",
        "وَهُوَ الَّذِي أَحْسَنَ فَضْلاً الصُّوَرْ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "هُوَ تَعَالَى اللَّهُ وَالرَّحْمَانُ",
        "نِعْمَ الرَّحِيمُ مِنْهُ جَاءَ الأَمَانُ"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "وَاجَهْتُ مَوْجُودًا قَدِيمًا بَاقِيَا",
        "مُخَالِفًا مُسْتَغْنِيًا مُلَاقِيَا"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "لَاقَيْتُ مَا لِيَ اخْتَارَ الْبَاقِي الْقَدِيمْ",
        "دُنْيَا وَأُخْرَى مِنْ عَجَائِبَ تَدُومْ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "يَنْقَادُ لِيَ الْجُودُ مِنَ الْمَوْجُودِ",
        "قِدَمُهُ قَدَّمَنِي بِالْجُودِ"
      ]
    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "يَنْقَادُ لِي مِنَ الْقَدِيمِ الْبَاقِي",
        "مَا غَابَ عَنْ أَكَابِرِ السُّبَّاقِ"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "إِلَيَّ قَادَ مَنْ لَهُ الْمُخَالَفَهْ",
        "لِلْخَلْقِ مَا لِي اخْتَارَ لَنْ أُخَالِفَهْ"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "لَمْ يَنْحُنِي شَقًى وَلَا عَنَاءُ",
        "أَغْنَانِيَ الَّذِي لَهُ الْغِنَاءُ"
