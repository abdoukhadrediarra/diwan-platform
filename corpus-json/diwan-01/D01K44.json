    },
    {
      "position": 19,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 17,
      "hemistichs": [
        "يَشْكُرُ رَبَّ الْعَالَمِينَ كُلِّي",
        "وَصِرْتُ عَبْدًا لَمْ أَكُنْ بِكَلِّ"
      ]
    },
    {
      "position": 20,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 18,
      "hemistichs": [
        "نَفَعَنِي رَبُّ الأَرَاضِي وَالسَّمَا",
        "بِلَا مَضَرَّةٍ بِمَا لِي قَسَمَا"
      ]
    },
    {
      "position": 21,
      "section": "khatima",
      "kind": "prose",
      "bayt_number": null,
      "hemistichs": [
        "وَجَعَلَنِي بِهَاتَيْنِ الْقَصِيدَتَيْنِ أَحَبَّ إِلَى جُنْدِهِ الْغَالِبِينَ وَإِلَى حِزْبِهِ الْمُفْلِحِينَ مِنْ كَثِيرٍ مِنْ مَحْبُوبَاتِهِمْ بِلَا سَلَبٍ أَبَدًا آمِينَ يَا رَبَّ الْعَالَمِينَ يَا مَنْ لَا شَرِيكَ لَهُ فِي الْمُلْكِ يَا مَنْ لَهُ مُلْكُ السَّمَاوَاتِ وَالأَرْضِ يَا مَنْ عَلَى كُلِّ شَيْءٍ قَدِيرٌ وَمَا ذَلِكَ عَلَى اللَّهِ بِعَزِيزٍ إِنَّ رَبِّي لَسَمِيعُ الدُّعَاءِ سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ وَسَلَامٌ عَلَى الْمُرْسَلِينَ وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"
      ]
    }
