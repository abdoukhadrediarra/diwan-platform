    },
    {
      "position": 15,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 13,
      "hemistichs": [
        "مَلَّكَنِي مَا اخْتَارَهُ الْمَلِيكُ",
        "وَلِسِوَى ضَرِّي انْتَحَى الْمُلُوكُ"
