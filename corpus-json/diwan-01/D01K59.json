      "kind": "prose",
      "bayt_number": null,
      "hemistichs": [
        "بَاطِنًا مُدَّةَ مَكْثِي فِي الدُّنْيَا وَوَصَّلَ إِلَيَّ مُقَدِّمَاتِهَا فِي الْحَالِ وَكُلِّيَّتَهَا بِلَا سَلَبٍ أَبَدًا فِي الْمَآلِ وَأَظْهَرَ فِي هَذِهِ الْقَصِيدَةِ بَرَكَةً لَمْ تَظْهَرْ قَبْلَهَا قَطُّ فِي الدُّنْيَا آمِينْ يَا رَبَّ الْعَالَمِينَ"
