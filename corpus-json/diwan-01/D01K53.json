      "bayt_number": null,
      "hemistichs": [
        "حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ"
      ]
    },
    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "حَمْدِي لِرَبِّ الْعَالَمِينَ سَرْمَدَا",
        "مَنْ لَا يُرِينِي ضَرَرًا أَوْ كَمَدَا"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "سَاقَ لِيَ التَّقْوَى مَعَ الإِحْسَانِ",
        "مَنْ كَوْنُهِ لِي مَا امَّحَى أَنْسَانِي"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "بَارَكَ لِيَ النَّافِعُ فِي كُلِّيَّتِي",
        "عَقْدِي وَقَوْلِي عَمَلِي وَنِيَّتِي"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "نَوَيْتُ شُكْرَ مَنْ بِهِ يَجْرِي قَدَرْ",
        "فِي أَبَدٍ عَلَى بُِشَارَاتِ الْقَدَرْ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "أَشْكُرُهُ سُبْحَانَهُ بِالْعَادَهْ",
        "مَعَ الْعِبَادَاتِ بِخَرْقِ العَادَهْ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "إِلَيْهِ عَقْدِي وَمَقَالِي كَالْفِعَالْ",
        "وَخُلُقِي وَلِي جَادَ بِانْفِعَالْ"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "لِوَجْهِهِ الْكَرِيمِ فَارَقْتُ الْمَبِيعْ",
        "وَمِنِّي اشْتَرَاهُ قَبْلُ فِي رَبِيعْ"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "لِبَمْسَشْ مِنْ أَسَشٍ تَقَبَّلَا",
        "وَبِصِرَاطِهِ كَفَانِي السُّبُلَا"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "أَجَابَنِي مَنْ لَيْسَ يَخْفَى شَيْءُ",
        "عَلَيْهِ بِالَّذِي بِهِ جَآ الْفَيْءُ"
      ]
    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "هَدِيَّةُ الْبَاقِي مَحَتْ مَا سَاءَا",
        "قَبْلُ وَغَابَتْ بِالَّذِي أَسَاءَا"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "وَاجَهْتُ رَبَّ الأَرَضِينَ وَالسَّمَا",
        "بِخَيْرِ شُكْرٍ بَعْدَ حَمْدٍ رُسِمَا"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "نَسَخْتُ بِالشُّكْرِ الشِّكَايَةَ فَلَمْ",
        "يَشْكُ لَهُ الْعَامَ الْمِدَادُ وَالْقَلَمْ"
      ]
    },
    {
      "position": 15,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 13,
      "hemistichs": [
        "عَنْهُ رَضِيتُ وَهْوَ عَنِّي رَاضِ",
        "وَنِعْمَ ذُو السَّمَاءِ وَالأَرَاضِي"
      ]
    },
    {
      "position": 16,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 14,
      "hemistichs": [
        "مَلَّكْتُ حَمْدِيَ وَكُلَّ شُكْرِ",
        "مَنْ مِنْ لَدُنْهُ جَادَ لِي بِالذِّكْرِ"
      ]
    },
    {
      "position": 17,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 15,
      "hemistichs": [
        "الْحَمْدُ لِلَّهِ إِلَهِ الْعَالَمِينَ",
        "عَلَى الأَمِينِ وَالأَمِينِ وَالأَمِينْ"
      ]
    },
    {
      "position": 18,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 16,
      "hemistichs": [
        "لَهُ خِطَابِي فِي رَبِيعٍ الثَّانِي",
        "وَقَادَ لِي الْقُرْآنَ كَالْمَثَانِي"
