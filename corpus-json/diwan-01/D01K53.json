    },
    {
      "position": 19,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 17,
      "hemistichs": [
        "وَكِيلُ أَنْتَ اللَّهُ وَالرَّحْمَانُ",
        "أَنْتَ الرَّحِيمُ وَلَكَ الأَزْمَانُ"
      ]
    },
    {
      "position": 20,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 18,
      "hemistichs": [
        "كَفَيْتَنِي الْكُفْرَ وَكُلَّ مَنْ كَفَرْ",
        "وَبِي هَدَيْتَ نَفَرًا بَعْدَ نَفَرْ"
      ]
    },
    {
      "position": 21,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 19,
      "hemistichs": [
        "يَقُودُنِي حُبُّ الإِلَهِ وَالرَّسُولْ",
        "لَهُ بِهِ وَقَبْلُ حُزْتُ خَيْرَ سُولْ"
      ]
    },
    {
      "position": 22,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 20,
      "hemistichs": [
        "لِلَّهِ رَبِّ الْعَالَمِينَ سَرْمَدَا",
        "حَمْدٌ وَشُكْرٌ يَنْفِيَانِ الْكَمَدَا"
      ]
    },
    {
      "position": 23,
      "section": "khatima",
      "kind": "prose",
      "bayt_number": null,
      "hemistichs": [
        "وَاللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ كَتَبَ اللَّهُ تَبَارَكَ وَتَعَالَى بِلَا مَحْوٍ أَبَدًا أَنَّ كَاتِبَ هَذِهِ الْحُرُوفِ لَا يَتَوَجَّهُ إِلَيْهِ الشَّيْطَانُ الرَّجِيمُ وَلَا شَيْءٌ مِنَ الشَّيْطَانِ الرَّجِيمِ أَبَدًا كَتَبَ اللَّهُ تَبَارَكَ وَتَعَالَى أَنَّ كَاتِبَ هَذِهِ الْحُرُوفِ أَيَّسَ الشَّيْطَانُ الرَّجِيمُ مِنْهُ وَاسْتَعَاذَ مِنْهُ وَخَافَ مِنْهُ وَاللَّهُ عَلَى مَا نَقُولُ وَكِيلٌ"
      ]
    }
  ]
