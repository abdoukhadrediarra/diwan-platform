    },
    {
      "position": 20,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 18,
      "hemistichs": [
        "بَارَكَ لِي فِي الْعَقْدِ وَالنِّيَّاتِ",
        "وَالْقَوْلِ وَالْفِعْلِ مَعَ الْآيَاتِ"
      ]
    },
    {
      "position": 21,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 19,
      "hemistichs": [
        "فَرَّحْتُ أَفْضَلَ الْوَرَى تَفْرِيحَا",
        "وَقَادَ لِي خِدْمَتَهُ تَصْرِيحَا"
      ]
    },
    {
      "position": 22,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 20,
      "hemistichs": [
        "يَقُودُ لِي الْجِنَاسَ خَيْرُ النَّاسِ",
