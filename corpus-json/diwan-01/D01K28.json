      "hemistichs": [
        "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ وَصَلَّى اللَّهُ عَلَى سَيِّدِنَا مُحَمَّدٍ وَعَلَى آلِهِ وَصَحْبِهِ وَسَلَّمَ تَسْلِيمًا كَمَا وَهَبَ لِي قَوْلَهُ"
      ]
    },
    {
      "position": 2,
      "section": "title",
      "kind": "title",
      "bayt_number": null,
      "hemistichs": [
        "وَعَلَّمَهُ مِمَّا يَشَاءُ لَا رَيْبَ فِيهِ"
      ]
    },
    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "وَسَّعَ لِي الْوَاسِعُ فِي الدَّارَيْنِ",
        "كَمَا حَمَانِيَ عَنِ النَّارَيْنِ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "عَلَّمَنِي الْعَلِيمُ تَعْلِيمًا عَجَزْ",
        "عَنْهُ سِوَاهُ وَلِيَ الْوَعْدَ نَجَزْ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "لَقَّنَنِي تَلْقِينَ هَادٍ اسْتَحَالْ",
        "عَلَيْهِ جَهْلٌ مُغْنِيًا عَنِ ارْتِحَالْ"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "لَقِيَنِي لِقَاءَ مَنْ شَاءَ فَعَلْ",
        "بِلَا إِمَاتَةٍ وَمَا رُمْتُ انْفَعَلْ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "مَدَّ لِقَلْبِي الزُّهْدَ فِي غَيْرِ صَوَابْ",
        "وَمَدَّ فِي الدَّارَيْنِ لِي خَيْرَ ثَوَابْ"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "هَدَمَ مَا بَنَاهُ كُلُّ مَنْ قَصَدْ",
        "مَضَرَّتِي وَصَانَنِي عَمَّنْ رَصَدْ"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "مَلَّكَنِي نَفْسِي وَلَمْ يُسَلِّطَا",
        "عَلَيَّ شَيْءٌ لِي يُؤَدِّي غَلَطَا"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "مَدَدْتُ فِي الْبُحُورِ لِلَّهِ يَدِي",
        "بِخِدْمَةِ الْمُشَفَّعِ الْمُؤَيَّدِ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "إِلَيَّ قَادَ اللَّهُ مِنْهُ أَجْرَا",
        "بِلَا حِسَابٍ وَكَفَانِي الْحِجْرَا"
      ]
    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "يَقُودُ لِي الْعِلْمَ بِلَا تَعَلُّمِ",
        "وَصَانَ جُثَّتِي عَنِ التَّأَلُّمِ"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "شَكَرْتُ رَبِّيَ لَدَى تَغَرُّبِي",
        "شُكْرًا بِهِ لِي قَادَ خَيْرَ الْقُرَبِ"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "إِلَيْهِ قُدْتُ أَرْفَعَ التَّوْحِيدِ",
        "عِنْدَ ذَوِي التَّثْلِيثِ وَالْجُحُودِ"
      ]
    },
    {
      "position": 15,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 13,
      "hemistichs": [
        "آتَانِيَ الْقُرْآنَ مِنْ لَدُنْهُ",
        "كَمَا هَدَانِي وَرَضِيتُ عَنْهُ"
      ]
    },
    {
      "position": 16,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 14,
      "hemistichs": [
        "لَمْ يَنْحُنِي شَكٌّ لَدَى مَنِ افْتَرَى",
        "وَمَا نَحَا لِجِهَتِي مِنِ افْتَرَآ"
      ]
    },
    {
      "position": 17,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 15,
      "hemistichs": [
        "إِلَيَّ قَادَ مَالِكِي خَيْرَ الْقِرَى",
        "بِلَا مَسِيرٍ لِلْبِلَادِ وَالْقُرَى"
      ]
    },
    {
      "position": 18,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 16,
      "hemistichs": [
        "رَضِيتُ عَنْهُ وَارْتَضَى أَعْرَاضِي",
        "وَيَخْرِقُ الْعَادَةَ فِي أَغْرَاضِي"
