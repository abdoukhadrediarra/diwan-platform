    },
    {
      "position": 19,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 17,
      "hemistichs": [
        "يَشْكُرُهُ الْبَدَنُ بِالْأَنْفَاسِ",
        "بِغَيْرِ لَغْوٍ وَبِلَا عِفَاسِ"
