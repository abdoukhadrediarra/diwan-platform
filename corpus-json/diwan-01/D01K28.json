    {
      "position": 23,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 21,
      "hemistichs": [
        "هَرَبَ مُتْعِبِيَ فِي الدَّارَيْنِ",
        "إِلَى النَّدَامَةِ وَلِلْعَارَيْنِ"
