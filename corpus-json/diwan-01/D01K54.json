    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "هَوْلُ الْقِيَامَةِ يَؤُمُّ غَيْرِي",
        "وَكُلُّ شَيْءٍ جَالِبٌ لِضَيْرِ"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "وَقَانِيَ الْحِسَابَ وَالْعَذَابَا",
        "مَنْ مَنْ يَمِلْ لِضَرَرِي أَذَابَا"
