    },
    {
      "position": 16,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 14,
      "hemistichs": [
        "مَدَّ لِيَ الْحَقُّ الَّذِي بِهِ دَمَغْ",
        "بَاطِلَ مَنْ رَامَ أَذَايَ فَانْدَمَغْ"
      ]
    },
    {
      "position": 17,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 15,
      "hemistichs": [
        "إِلَيَّ مَدَّ سِرَّهُ الْمَصُونَا",
        "مَنْ قَادَ لِي مَا أَخْجَلَ الْحُصُونَا"
