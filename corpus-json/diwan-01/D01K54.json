    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "حُبِّيَ لِلَّهِ وَلِلْكِتَابِ",
        "وَلِلرَّسُولِ قَدْ مَحَا عِتَابِي"
