    },
    {
      "position": 23,
      "section": "khatima",
      "kind": "prose",
      "bayt_number": null,
      "hemistichs": [
        "وَنِعْمَ الْمَوْلَى وَنِعْمَ النَّصِيرُ سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ وَسَلَامٌ عَلَى الْمُرْسَلِينَ وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"
      ]
    }
