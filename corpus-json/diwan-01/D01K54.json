    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "نَزَعَ لِي مَا اخْتَارَ لِي أَنْ يَنْزِعَهْ",
        "لِيَ وَلِي سَلَبَ مَنْ لَمْ يَنْزِعَهْ"
      ]
    },
    {
      "position": 15,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 13,
      "hemistichs": [
        "عَلَّمَنِي مِمَّا يَشَاءُ اللَّهُ",
        "فَضْلاً وَلَا إِلَهَ إِلَّا اللَّهُ"
