    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "سَالَمَنِي الْحَسُودُ وَالْمُعَادِي",
        "مُسْتَغْنِيًا عَنْ نَحْوِ مَا لِعَادِ"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "بَارَكَ فِي عَقْدِي وَقَوْلِي وَالْفِعَالْ",
        "وَجُمْلَةِ الأَخْلَاقِ مُغْنٍ بِفَعَالْ"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "نَفَعَنِي بِمَا بِهِ يَغْبِطُنِي",
        "سِوَايَ فِيهِ عَاصِمِي بِوَطَنِي"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "إِلَى سِوَى دُورِي انْتَحَآ الْعَرَمْرَمِ",
        "وَأَهْلُ بَدْرٍ هُمْ حُمَاةُ حَرَمِي"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "إِلَى سِوَايَ زَحْزَحَ الدَّجَّالَا",
        "رَبِّي وَمَا لِي بِالْفَسَادِ جَالَا"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "لَمْ يَنْحُنِي إِبْلِيسُ حَيْثُ كَانَا",
        "بِطَرْدِ مَنْ طَيَّبَ لِيَ الْمَكَانَا"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "لَمْ يَنْحُنِي كَافِرٌ أَوْ فَاسِقٌ أَوْ",
        "مُشْرِكٌ أَوْ شَرٌّ لِغَيْرِيَ نَأَوْ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "إِلَى جِنَانِ اللَّهِ كُلِّي يَقْصِدُ",
        "حِينَ الْفُتُونُ لِلْبَرَايَا تَقْصِدُ"
