    },
    {
      "position": 18,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 16,
      "hemistichs": [
        "لَهُ خِطَابِي قَبْلُ وَهْوَ خَيْرُ مَنْ",
        "لَهُ تَوَجَّهَ الْخِطَابُ فِي زَمَنْ"
      ]
    },
    {
      "position": 19,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 17,
      "hemistichs": [
        "وَاجَهَنِي بَعْدَ الْخِطَابِ بِالْجَوَابْ",
        "مُغْنٍ وَمُشْكٍ وَظَفِرْتُ بِثَوَابْ"
      ]
    },
    {
      "position": 20,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 18,
      "hemistichs": [
        "كِتَابُهُ انْسَلَبَ لِي وَلِي جَمَعْ",
        "سُؤْلِي وَإِنَّهُ لِيَ الْعِدَى قَمَعْ"
      ]
    },
    {
      "position": 21,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 19,
      "hemistichs": [
        "يَنْسَلِبُ الْحَلَالُ لِي بِلَا حِسَابْ",
        "وَعَادَتِي مَعَ عِبَادَاتِي احْتِسَابْ"
      ]
    },
    {
      "position": 22,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 20,
      "hemistichs": [
        "لِي قَادَ حُبَّ اللَّهِ وَالْكِتَابِ",
        "وَحُبُّ أَحْمَدَ امِّحَا الْعِتَابِ"
