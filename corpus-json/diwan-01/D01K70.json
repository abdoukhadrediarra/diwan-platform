    },
    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 1,
      "hemistichs": [
        "قَادَ لِيَ الْقُرْآنَ رَبِّيَ الْوَلِي",
        "قَوْدًا بَدَا لِي فِي رَبِيعِ الأَوَّلِ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "إِذَا قَرَأْتُ آيَةً أَوْ أَكْثَرَا",
        "قَادَ لِيَ الْبَاقِي ثَوَابًا كَثُرَا"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "لَمْ يَنْحُنِي مَا يُورِثُ الأَحْزَانَا",
        "وَاللَّهُ مِنِّي رَفَعَ الأَوْزَانَا"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "لَمْ يَنْحُنِي مَا يُورِثُ الأَمْرَاضَا",
        "وَاللَّهُ مِنِّي قَبِلَ الأَعْرَاضَا"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "إِلَيَّ قَادَ مَنْ رَعَانِي الأَعْظَمَا",
        "وَخَافَ مِنِّي كُلُّ مَنْ تَعَظَّمَا"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
