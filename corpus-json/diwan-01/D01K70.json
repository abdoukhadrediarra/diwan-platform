    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "هَدَيْتَنِي يَا رَبِّ خُذْ شُكُورِي",
        "وَأَنْتَ خَيْرُ رَازِقٍ شَكُورِ"
