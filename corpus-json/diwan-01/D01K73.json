      "hemistichs": [
        "بَارَكَ لِيَ الْبَاقِي بِلَا انْتِهَاءِ",
        "فِي ثَمَنِي وَالْبَيْعُ ذُو انْتِهَاءِ"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "رَبِحْتُ فِي ثَمَنِ لَجْ وَثَمَنِ",
        "ضَمَائِرِي وَلِي طَابَ زَمَنِي"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
