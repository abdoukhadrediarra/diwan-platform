    },
    {
      "position": 19,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 18,
      "hemistichs": [
        "رَضِيَ عَنِّي مَنْ لَهُ تَوْحِيدِي",
        "بِالْمُصْطَفَى الْمُقَدَّمِ الْوَحِيدِ"
