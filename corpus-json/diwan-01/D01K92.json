    },
    {
      "position": 24,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 23,
      "hemistichs": [
        "رَسُولُنَا صَلَّى عَلَيْهِ اللَّهُ",
        "فِي الآلِ وَالصَّحْبِ وَمَنْ وَالَاهُ"
