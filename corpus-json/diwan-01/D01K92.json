    },
    {
      "position": 27,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 26,
      "hemistichs": [
        "لِلْمُصْطَفَى لَيْثِ الْعِدَى بَحْرِ النَّدَى",
        "وَجَّهْتُ أَمْدَاحًا كَفَتْ مَنْ فَنَدَا"
      ]
    },
    {
      "position": 28,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 27,
      "hemistichs": [
        "هَدِيَّتِي لَهُ كَفَتْنِيَ الْعَارَا",
        "وَخَلَّصَتْ لَدَى الْعِدَى إِذْعَارَا"
      ]
