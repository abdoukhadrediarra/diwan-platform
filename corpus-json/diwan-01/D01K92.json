    },
    {
      "position": 3,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 2,
      "hemistichs": [
        "نَحْمَدُهُ عَلَى كِتَابٍ رَفَعَا",
        "دِينَ النَّبِيِّ الْمُنْتَقَى فَارْتَفَعَا"
      ]
    },
    {
      "position": 4,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 3,
      "hemistichs": [
        "نَشْكُرُهُ عَلَى كِتَابٍ نَصَبَا",
        "حِصْنًا حَصِينًا قَدْ كَفَانِي نَصَبَا"
      ]
    },
    {
      "position": 5,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
        "أَحْمَدُ رَبِّيَ الَّذِي قَدْ خَفَضَا",
        "مَنْ سَاءَهُ تَقْدِيمُنَا فَانْخَفَضَا"
      ]
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 5,
      "hemistichs": [
        "لِلَّهِ حَمْدِيَ دَوَامًا وَجَزَمْ",
        "سُرُورَ كُلِّ مَنْ قَلَانِي فَانْجَزَمْ"
      ]
    },
    {
      "position": 7,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 6,
      "hemistichs": [
        "لِلَّهِ شُكْرِي وَإِلَيْهِ ضَمَّا",
        "بِالْمُصْطَفَى كُلِّي رِضًى فَانْضَمَّا"
      ]
    },
    {
      "position": 8,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 7,
      "hemistichs": [
        "هَدَمَ مَا بَنَى الْعِدَى وَفَتَحَا",
        "بَابَ خُيُورِهِ لَنَا فَانْفَتَحَا"
      ]
    },
    {
      "position": 9,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 8,
      "hemistichs": [
        "بَارَكَ فِي كُلِّيَّتِي لِي وَكَسَرْ",
        "سِلَاحَ مَنْ كَانَ يُجَارِي فَانْكَسَرْ"
      ]
    },
    {
      "position": 10,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 9,
      "hemistichs": [
        "رَفَعَ دِينَ الْمُنْتَقَى الْمُشَفَّعِ",
        "مَنْ جَزَمَ الْعِدَى بِفَضْلِ الأَنْفَعِ"
      ]
    },
    {
      "position": 11,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 10,
      "hemistichs": [
        "يَقُودُ أَفْضَلَ الصَّلَاةِ وَالسَّلَامْ",
        "بِلَا انْتِهَا إِلَى نَبِيِّنَا السَّلَامْ"
      ]
    },
    {
      "position": 12,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "آتَاهُ فِي آلٍ وَصَحْبٍ كَسَرُوا",
        "جُيُوشَ مَنْ لَازَمَهُمْ تَحَسُّرُ"
      ]
    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 12,
      "hemistichs": [
        "مَا لَا يُعَدُّ مِنْ أَمَانٍ وَسُرُورْ",
        "بَاقٍ كَفَى خَدِيمَهُ ذَوِي الْغُرُورْ"
      ]
    },
    {
      "position": 14,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 13,
      "hemistichs": [
        "نَبِيُّنَا أَحْمَدُ لَنْ يُجَارَى",
        "زَحْزَحَ عَامَ أَكَسَشٍ فُجَّارَا"
      ]
    },
    {
      "position": 15,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 14,
      "hemistichs": [
        "أَحْمَدُهُ وَمَدْحُهُ قَدْ زَانَا",
        "كُلِّيَّتِي وَشَكَرَ الْمِيزَانَا"
      ]
    },
    {
      "position": 16,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 15,
      "hemistichs": [
        "لَهُ امْتِدَاحِي مُدَّةً مُرْتَضِيَا",
        "عَنْهُ وَعَنِّي دُونَ سُخْطٍ رَضِيَا"
      ]
    },
    {
      "position": 17,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 16,
      "hemistichs": [
        "مَدْحِي لَهُ إِلَى جُمَادَى الثَّانِيَهْ",
        "مِنَ الْمُحَرَّمِ هَدَايَا صَافِيَهْ"
      ]
    },
    {
      "position": 18,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 17,
      "hemistichs": [
        "شُكْرِي بِأَنْفَعِ الصَّلَاةِ مِنْ رَجَبْ",
        "لِخَتْمِ ذِي الْحِجَّةِ جَادَ بِالْعَجَبْ"
