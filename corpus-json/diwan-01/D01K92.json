      ]
    },
    {
      "position": 22,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 21,
      "hemistichs": [
        "نَحْوًا يَصُونُ ذِكْرَهُ الْحَكِيمَا",
        "وَقَادَ لِيَ التَّقْدِيمَ وَالتَّحْكِيمَا"
      ]
    },
    {
      "position": 23,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 22,
      "hemistichs": [
        "وَجَّهَ لِي عِلْمًا وَسَعْيًا وَأَدَبْ",
        "مَنْ كَانَ لِي بِالأَمْنِ مِنْ غَيْرِ وَدَبْ"
