    },
    {
      "position": 13,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 11,
      "hemistichs": [
        "كِتَابَتِي مِنْ لَوْحِ رَبِّي تَنْقُلُ",
        "لَا يَمْتَرِي فِيهِ نَبِيهٌ يَعْقِلُ"
