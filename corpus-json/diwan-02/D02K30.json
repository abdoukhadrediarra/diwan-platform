        "فَإِنِّي خَدِيمٌ لِلنَّبِي وَهْوَ سُلَّمِي"
      ],
      "acrostic_spans": []
    },
    {
      "position": 6,
      "section": "matn",
      "kind": "bayt",
      "bayt_number": 4,
      "hemistichs": [
